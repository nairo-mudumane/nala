{
  "name": "core",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=../.env run --hot src/index.ts",
    "start": "bun --env-file=../.env run src/index.ts",
    "start:prod": "bun run src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nala/typescript-config": "workspace:*",
    "@types/bun": "^1.3.3",
    "@types/json-schema": "^7.0.15",
    "openapi-types": "^12.1.3",
    "typescript": "^5"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.0",
    "@nala/auth": "workspace:*",
    "@nala/db": "workspace:*",
    "@scalar/hono-api-reference": "0.11.11",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "^0.2.9",
    "hono": "^4.12.31",
    "hono-openapi": "1.3.1",
    "zod": "4.4.3"
  }
}
