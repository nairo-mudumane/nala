{
  "name": "nala",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.3",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "web",
    "core",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=web",
    "dev:core": "turbo dev --filter=core",
    "start": "turbo start",
    "start:web": "turbo start --filter=web",
    "start:core": "turbo start --filter=core",
    "build": "turbo build",
    "build:web": "turbo build --filter=web",
    "build:core": "turbo build --filter=core",
    "lint": "biome lint .",
    "lint:web": "biome lint web",
    "lint:core": "biome lint core",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@nala/typescript-config": "workspace:*",
    "turbo": "^2.9.18",
    "typescript": "^5"
  },
  "dependencies": {
    "@nala/db": "workspace:*",
    "nanoid": "^6.0.0"
  }
}
