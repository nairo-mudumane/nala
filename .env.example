# Origins allowed to call `core` (CORS allow-list + Clerk's authorizedParties).
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Where `web`'s server functions reach `core`. Server-side only — the browser
# never calls `core` directly, so this deliberately has no `VITE_` prefix.
CORE_URL=http://localhost:3001
