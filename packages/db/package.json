    "./schema": "./src/schema/index.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@nala/typescript-config": "workspace:*",
    "@types/bun": "^1.3.3",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "0.31.10",
    "pg": "^8.16.3",
    "typescript": "^5"
  }
}
